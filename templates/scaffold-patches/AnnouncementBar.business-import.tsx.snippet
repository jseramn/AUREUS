"use client";

import { useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { X, Sparkles, ArrowRight } from "lucide-react";
// OBLIGATORIO si se usa BUSINESS.* en este client component:
import { BUSINESS } from "@/lib/constants";

/**
 * AnnouncementBar — patrón correcto (import BUSINESS).
 * Alternativa válida: hardcodear el nombre del lead como string (odontólogos).
 */
export function AnnouncementBar() {
  const [visible, setVisible] = useState(() => {
    if (typeof window !== "undefined") {
      return !sessionStorage.getItem("announcement-dismissed");
    }
    return false;
  });

  const handleDismiss = () => {
    setVisible(false);
    sessionStorage.setItem("announcement-dismissed", "true");
  };

  return (
    <AnimatePresence>
      {visible && (
        <motion.div
          initial={{ height: 0, opacity: 0 }}
          animate={{ height: "auto", opacity: 1 }}
          exit={{ height: 0, opacity: 0 }}
          transition={{ duration: 0.3, ease: "easeInOut" }}
          className="bg-forest text-cream overflow-hidden relative z-[60]"
        >
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-center gap-3 py-2.5">
            <Sparkles className="w-3.5 h-3.5 text-sage-light shrink-0 hidden sm:block" />
            <p className="text-xs sm:text-sm font-medium text-cream/90 text-center">
              <strong className="text-cream">{BUSINESS.name}</strong>
              {" "}— {BUSINESS.tagline}
              <span className="hidden sm:inline"> por WhatsApp</span>
            </p>
            <a
              href="#servicios"
              className="hidden sm:inline-flex items-center gap-1 text-xs font-semibold text-sage-light hover:text-cream transition-colors shrink-0 group"
            >
              Ver más
              <ArrowRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
            </a>
            <button
              onClick={handleDismiss}
              className="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full hover:bg-cream/10 flex items-center justify-center transition-colors min-w-[28px] min-h-[28px]"
              aria-label="Cerrar anuncio"
            >
              <X className="w-3.5 h-3.5 text-cream/50 hover:text-cream/80" />
            </button>
          </div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}
