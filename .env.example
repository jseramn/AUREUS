# ══════════════════════════════════════════════════════════════
# Fábrica AUREUS v1 (Cursor-native) — variables activas
# ══════════════════════════════════════════════════════════════

# Path del store JSON del pipeline (default: ./state/pipeline.json)
FABRICA_STATE=./state/pipeline.json

# Apex con wildcard DNS apuntando a Vercel (default de --domain en deploy)
FABRICA_DOMAIN=

# Cuenta/org de GitHub donde se crean los repos de los sitios (default de --org)
FABRICA_GH_ORG=

# Identidad Git para commits de los repos generados (placeholders; no uses
# un nombre o correo reales de una persona concreta en este archivo).
# FABRICA_GIT_NAME=Your Name
# FABRICA_GIT_EMAIL=you@example.com

# PAT de GitHub con scope `repo` (crear repos de sitios + push).
# En Cursor Cloud: NO ponerlo aquí — agregarlo como Secret (Dashboard →
# Cloud Agents → Secrets → GH_TOKEN) y cada VM lo inyecta automáticamente.
# El token integrado de Cursor (cursor[bot]) NO puede crear repos ni pushear
# a repos fuera del run — sin este PAT, deploy usa solo Vercel CLI.
# GH_TOKEN=

